root = true

[*.{kt,kts}]
ktlint_code_style = android_studio
charset = utf-8
indent_size = 4
insert_final_newline = true
max_line_length = 120
ij_kotlin_align_multiline_parameters_in_calls = true
ij_kotlin_align_multiline_parameters = true
ij_kotlin_blank_lines_around_block_when_branches = 0
ij_kotlin_blank_lines_after_class_header = 1
ij_kotlin_blank_lines_before_rbrace = 0
ij_kotlin_imports_layout = *
ij_kotlin_allow_trailing_comma = true
ij_kotlin_wrap_before_assignment = true
ktlint_standard_no-wildcard-imports = enabled

[*.kt]
ktlint_function_naming_ignore_when_annotated_with = Composable, Preview